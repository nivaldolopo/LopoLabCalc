rules_version = '2';

// -----------------------------------------------------------------------------
// Regras do Firestore — banco `lopo-lab-calculadora` (projeto lopo-lab).
//
// TD-005: versionadas aqui para NÃO viverem só no Console. Este arquivo é uma
// CÓPIA FIEL do que está valendo no Console — a lógica abaixo é idêntica à do
// painel; só este cabeçalho é comentário extra. A trava libera só as contas
// Google verificadas cuja conta está na lista (mesmas de `ALLOWED_EMAILS` em
// src/features/pricing-calculator/constants.ts — manter em sincronia).
//
// ✅ CONFERIDO em 2026-09-08 (AUD-08), por DIFF mecânico, não de olho: as 17
// linhas significativas batem com o ruleset publicado. A versão no ar é a de
// 2026-08-10 19:55, e o commit 4be2c4b (que somou o joao) é de 19:43 do mesmo
// dia — o deploy saiu 12 min depois. O Console guarda 5 versões; as anteriores
// são de 12/07 e três de 27/06.
//
// IMPORTANTE: o deploy NÃO é automático. O site sobe pela Vercel (push na main);
// estas regras só sobem se alguém rodar `firebase deploy --only firestore:rules`
// de propósito. Mexeu aqui? Ou deploya, ou o Console e o repo divergem calados —
// e o `pnpm test:rules` estará provando um texto que não é o que está no ar.
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'nivaldo.lopo@gmail.com',
          'lopolab3d@gmail.com',
          'joao.zarbielli@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if autorizado();
    }
  }
}
